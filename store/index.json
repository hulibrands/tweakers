            "asset": "thread-app-shell-chrome-*.js",
            "anchor": "Le=k&&!D.some(st)",
            "replacement": "Le=k&&D.filter(st).length<25",
            "description": "Allow multiple browser right-panel tabs before hiding the browser plus-menu entry."
          },
          {
            "id": "review-runtime-bridge-browser-tab-detector",
            "asset": "thread-app-shell-chrome-*.js",
            "anchor": "function st(e){return e.tabId===se.BROWSER}",
            "replacement": "function st(e){return e.tabId===se.BROWSER||typeof e.tabId===\"string\"&&e.tabId.startsWith(se.BROWSER+\":\")}",
            "description": "Treat browser tab ids with BROWSER-prefixed suffixes as browser tabs."
          },
          {
            "id": "review-runtime-bridge-find-shortcut-detector",
            "asset": "review-runtime-bridge-*.js",
            "anchor": "if(!n||e!==T.BROWSER)return!1;",
            "replacement": "if(!n||!(e===T.BROWSER||typeof e===\"string\"&&e.startsWith(T.BROWSER+\":\")))return!1;",
            "description": "Keep browser find-shortcut routing active for suffixed browser tab ids."
          },
          {
            "id": "review-runtime-bridge-browser-overlay-condition",
            "asset": "review-runtime-bridge-*.js",
            "anchor": "h=i?.tabId!==T.BROWSER||!a||o",
            "replacement": "h=!(i?.tabId===T.BROWSER||typeof i?.tabId===\"string\"&&i.tabId.startsWith(T.BROWSER+\":\"))||!a||o",
            "description": "Apply browser overlay behavior to suffixed browser tab ids."
          },
          {
            "id": "app-shell-browser-shortcut-active-tab",
            "asset": "app-shell-*.js",
            "anchor": "d=s?.tabId===Be.BROWSER?c:null",
            "replacement": "d=(s?.tabId===Be.BROWSER||typeof s?.tabId===\"string\"&&s.tabId.startsWith(Be.BROWSER+\":\"))?c:null",
            "description": "Report right-panel browser shortcut state for suffixed browser tab ids."
          },
          {
            "id": "app-shell-browser-close-active-tab",
            "asset": "app-shell-*.js",
            "anchor": "s?.tabId===Be.BROWSER&&Ve.closeTab(t,s.tabId)",
            "replacement": "(s?.tabId===Be.BROWSER||typeof s?.tabId===\"string\"&&s.tabId.startsWith(Be.BROWSER+\":\"))&&Ve.closeTab(t,s.tabId)",
            "description": "Close the active suffixed browser tab from app-shell close commands."
          }
