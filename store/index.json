      "manifest": {
        "id": "co.thomashulihan.better-browser-agent",
        "name": "Better Browser Agent",
        "version": "0.1.0",
        "githubRepo": "hulibrands/tweakers",
        "forkOf": {
          "upstreamId": "co.bennett.better-browser",
